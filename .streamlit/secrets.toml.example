# WhyNow secrets for Streamlit Community Cloud.
# Deployed: paste these lines into your app's Settings > Secrets on share.streamlit.io, with your own values.
# Local: copy this file to .streamlit/secrets.toml (git-ignored) or keep using .env.
# Never commit real values.

COMPANIES_HOUSE_API_KEY = ""
TAVILY_API_KEY = ""
GEMINI_API_KEY = ""

# Unlocks owner mode (open the app with ?owner=1). Leave empty to turn owner mode off.
OWNER_PASSWORD = ""
